{  
  "proxy": "填入您自己的代理地址",  
  "_comment_sub2api": "Sub2API 上传（sub2api_enabled=true 时生效，当前启用）", 
  "token_json_dir": "放账号信息的文件",  
  "sub2api_enabled": true,  
  "sub2api_url": "sub2api的地址",  
  "sub2api_token": "sub2api登录的token",  
  "sub2api_proxy_id": 1(sub2api上面添加的代理ip地址的id),  
  "sub2api_proxy": "",  
  "sub2api_concurrency": 10,  
  "sub2api_priority": 1,  
  "sub2api_rate_multiplier": 1,  
  "sub2api_group_ids": [2](添加到哪个分组管理的id),  
  "sub2api_model_mapping": {"claude-sonnet-4-6": "gpt-5.4", "gpt-5.4": "gpt-5.4"}(模型的映射，在添加账号那选的模型),  
  "sub2api_cron_interval": 30(多少秒执行一次)  
